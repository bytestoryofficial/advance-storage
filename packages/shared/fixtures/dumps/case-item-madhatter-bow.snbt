        "minecraft:lore": ["", {
            color: "#E8DCC8",
            text: "Вместо тетивы здесь натянута искаженная"
        }, {
            color: "#E8DCC8",
            text: "нить самого времени. Выпуская всего одну"
        }, {
            color: "#E8DCC8",
            text: "стрелу, вы обрушиваете на врага веер из"
        }, {
            color: "#E8DCC8",
            text: "смертоносных, острых как бритва карт."
        }, "", {
            color: "#D84848",
            extra: [
                {
                    color: "#FF7070",
                    text: "Карточный залп",
                    bold: 1b
                }
            ],
            text: "Способность: "
        }, {
            color: "#F0C4C4",
            text: "При полном натяжении вместо обычной стрелы"
        }, {
            color: "#F0C4C4",
            text: "выпускает веер из 3 светящихся огненных"
        }, {
            color: "#F0C4C4",
            text: "стрел, как арбалет с тройным выстрелом."
